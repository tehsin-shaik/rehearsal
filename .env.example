# Offline mode is the safe default.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Model providers (priority: OpenRouter, OpenAI, Gemini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXA_API_KEY=

# Gmail IMAP and OAuth
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_QUERY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/mail/callback

# ClickUp
CLICKUP_API_KEY=
CLICKUP_LIST_ID=
CLICKUP_TEAM_ID=
CLICKUP_ASSIGNEES=
# Example: CLICKUP_ASSIGNEES='{"Tehsin":"member-id","Elyes":"member-id","Raghad":"member-id","Ayah":"member-id","Sara":"member-id","Alex":"member-id"}'

# Jira Cloud
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_ASSIGNEES=

# Ambiguous workspace or disposable sandbox
AMBIGUOUS_SANDBOX=false
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=
AMBIGUOUS_CHANNEL_ID=

# Explicit tracker: clickup, jira, ambiguous, ambiguous_sandbox, or github
TRACKER=

# GitHub Issues
GITHUB_TOKEN=
GITHUB_REPO=

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
NEXT_PUBLIC_SLACK_AREA_CHANNELS=
# Example: NEXT_PUBLIC_SLACK_AREA_CHANNELS='{"technical-support":"C0123456789","billing-finance":"C0123456789","sales-support":"C0123456789","logistics-support":"C0123456789","product-development-engineering":"C0123456789","legal-privacy-compliance":"C0123456789","support-review":"C0123456789"}'

# Disable CopilotKit telemetry by default.
COPILOTKIT_TELEMETRY_DISABLED=true

# Verification safety gate. Keep false unless a disposable external write is intended.
REHEARSAL_ALLOW_EXTERNAL_WRITES=false
REHEARSAL_BASE_URL=http://localhost:3000
