# Complete offline demo: no credentials required. Both flags must agree.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
REHEARSAL_BASE_URL=http://localhost:3000
# Generate independent values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REHEARSAL_ACCESS_KEY=
REHEARSAL_BRIDGE_KEY=
EXTENSION_ID=

# Optional structured understanding: first configured provider wins.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXA_API_KEY=

# Gmail OAuth; enable Gmail API and register the exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/mail/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_QUERY=is:unread newer_than:7d
# Optional IMAP/SMTP through integrations/node-services. App-password takes precedence.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SEND_ENABLED=false

# Choose exactly one tracker: github, clickup, jira, ambiguous.
# Leave TRACKER absent until configured; see docs/INTEGRATIONS.md.
# TRACKER=github
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_ASSIGNEES=
# Example: {"Umar":"github-login","Awaiz":"another-github-login"}
CLICKUP_API_KEY=
CLICKUP_LIST_ID=
CLICKUP_TEAM_ID=
CLICKUP_ASSIGNEES=
# Example: {"Umar":"123456","Awaiz":"789012"}
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_ASSIGNEES=
# Example: {"Umar":"jira-account-id","Awaiz":"another-account-id"}

# Each department needs its own real Slack webhook. A webhook cannot override its channel.
SLACK_WEBHOOK_URL=
SLACK_AREA_WEBHOOKS=
# Example: {"technical-support":"https://hooks.slack.com/services/...","billing-finance":"https://hooks.slack.com/services/..."}
NEXT_PUBLIC_SLACK_AREA_CHANNELS=

# Contract-gated; intentionally unavailable until verified against vendor documentation.
AMBIGUOUS_SANDBOX=false
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=
AMBIGUOUS_CHANNEL_ID=

# Optional genuine CopilotKit v2 runtime, served by integrations/node-services.
COPILOTKIT_ENABLED=false
# Optional SDK telemetry preference; consult the SDK version's documentation.
COPILOTKIT_TELEMETRY_DISABLED=true
